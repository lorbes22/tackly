{
  "name": "NodeNote",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Node this note is attached to"
    },
    "session_id": {
      "type": "string",
      "description": "Session the node belongs to (denormalized for board-level note-count queries)"
    },
    "text": {
      "type": "string",
      "description": "The note text"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner's email for RLS when appended by a service-role writer"
    }
  },
  "required": ["node_id", "text"],
  "rls": {
    "create": { "created_by": "{{user.email}}" },
    "read": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.owner_email": "{{user.email}}" }
      ]
    },
    "update": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.owner_email": "{{user.email}}" }
      ]
    },
    "delete": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.owner_email": "{{user.email}}" }
      ]
    }
  }
}
