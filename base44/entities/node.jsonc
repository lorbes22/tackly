{
  "name": "Node",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User who owns this node"
    },
    "session_id": {
      "type": "string",
      "description": "Session in which this node was created"
    },
    "parent_id": {
      "type": "string",
      "description": "The node this one flows from (its single connector parent). Null for a root/independent branch. Drives the d3-hierarchy tree layout."
    },
    "pos_x": {
      "type": "number",
      "description": "Manual drag-override X (world space). Null = use the auto tree layout."
    },
    "pos_y": {
      "type": "number",
      "description": "Manual drag-override Y (world space). Null = use the auto tree layout."
    },
    "type": {
      "type": "string",
      "enum": ["topic", "idea", "evidence", "opinion", "question", "decision", "update", "risk", "action", "waffle", "fact", "plan", "aside"],
      "description": "Node taxonomy type — color always encodes type"
    },
    "title": {
      "type": "string",
      "description": "Short node title shown on the post-it"
    },
    "summary": {
      "type": "string",
      "description": "Longer summary of the thought"
    },
    "status": {
      "type": "string",
      "enum": ["open", "resolved", "done", "na"],
      "default": "na",
      "description": "Lifecycle: open/resolved for question+risk, open/done for action, na for static types"
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "Soft-delete / board-visibility toggle, separate from status. Hidden nodes keep their record + utterance links but never render and aren't re-attach targets."
    },
    "provisional": {
      "type": "boolean",
      "default": false,
      "description": "True while the node is still forming (raw placeholder -> rough guess); false once end_of_turn finalizes it. Renders in a dashed 'forming' state, distinct from an open Question/Risk."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Classifier confidence for the placement of this node"
    },
    "embedding": {
      "type": "array",
      "items": { "type": "number" },
      "description": "Embedding vector of title + summary for node matching"
    },
    "owner_label": {
      "type": "string",
      "description": "For action nodes: the owner of the follow-up, if known"
    },
    "position_x": {
      "type": "number",
      "description": "X position on the board canvas"
    },
    "position_y": {
      "type": "number",
      "description": "Y position on the board canvas"
    },
    "rotation_deg": {
      "type": "number",
      "description": "Random post-it rotation in degrees, assigned at creation"
    }
  },
  "required": ["session_id", "type", "title"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
