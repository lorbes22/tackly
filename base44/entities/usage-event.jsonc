{
  "name": "UsageEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who triggered the event"
    },
    "org_id": {
      "type": "string",
      "description": "Org context, if any"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "session_started",
        "session_completed",
        "transcript_imported",
        "node_created",
        "node_linked",
        "search_performed",
        "plan_limit_hit",
        "quota_warning_shown",
        "paywall_shown"
      ],
      "description": "What happened — feeds admin analytics and plan-limit enforcement"
    },
    "meta": {
      "type": "object",
      "description": "Arbitrary event payload (session_id, node counts, etc.)",
      "properties": {}
    }
  },
  "required": ["event_type"],
  "rls": {
    "create": { "created_by": "{{user.email}}" },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
