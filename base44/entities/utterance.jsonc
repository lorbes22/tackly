{
  "name": "Utterance",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Session this utterance belongs to"
    },
    "speaker_label": {
      "type": "string",
      "description": "Speaker name or label (e.g. 'Speaker 1', 'Me')"
    },
    "text": {
      "type": "string",
      "description": "Transcribed text of the utterance"
    },
    "start_ms": {
      "type": "integer",
      "description": "Start offset in milliseconds from session start"
    },
    "end_ms": {
      "type": "integer",
      "description": "End offset in milliseconds from session start"
    },
    "finalized": {
      "type": "boolean",
      "default": false,
      "description": "Whether streaming transcription has finalized this utterance"
    },
    "processed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Tier-1 classification pipeline has consumed this utterance"
    },
    "owner_email": {
      "type": "string",
      "description": "Session owner's email — set on webhook-ingested utterances so the owner can read them despite service-role creation"
    }
  },
  "required": ["session_id", "text"],
  "rls": {
    "create": { "created_by": "{{user.email}}" },
    "read": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.owner_email": "{{user.email}}" }
      ]
    },
    "update": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.owner_email": "{{user.email}}" }
      ]
    },
    "delete": {
      "$or": [
        { "created_by": "{{user.email}}" },
        { "data.owner_email": "{{user.email}}" }
      ]
    }
  }
}
