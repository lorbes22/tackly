{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "The board/thread this message belongs to — TacklyAI is scoped to a single session's own nodes/transcript, never cross-session."
    },
    "role": {
      "type": "string",
      "enum": ["user", "assistant"],
      "description": "Who said this — the user's question or TacklyAI's reply."
    },
    "text": {
      "type": "string",
      "description": "Message content."
    }
  },
  "required": ["session_id", "role", "text"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
