{
  "name": "NodeUtteranceLink",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Node this link belongs to"
    },
    "utterance_id": {
      "type": "string",
      "description": "Raw utterance that produced (part of) the node"
    }
  },
  "required": ["node_id", "utterance_id"],
  "rls": {
    "create": { "created_by": "{{user.email}}" },
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
