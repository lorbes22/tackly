{
  "name": "Plan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Plan display name (e.g. Free, Plus, Pro)"
    },
    "price_monthly": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "Monthly price in GBP"
    },
    "minute_limit": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "description": "Transcript minutes allowed per calendar month (personal capture + meetings + imports, all combined). 0 = unlimited."
    },
    "allows_meetings": {
      "type": "boolean",
      "default": true,
      "description": "Whether this plan can start/import meeting sessions at all (independent of minute quota). Every plan, including Free, currently sets this true — meetings are gated by the shared minute quota, not plan tier."
    },
    "features": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Feature flags / marketing bullets for this plan"
    },
    "stripe_price_id": {
      "type": "string",
      "description": "Stripe recurring Price id (price_...) this plan checks out against. Empty means this plan can't be purchased via Checkout yet."
    }
  },
  "required": ["name"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": true,
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
