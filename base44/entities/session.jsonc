{
  "name": "Session",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User who owns this session"
    },
    "owner_email": {
      "type": "string",
      "description": "Owner's email, stored explicitly at creation (created_by is not readable via the API, and the Recall webhook needs it to stamp utterances)"
    },
    "org_id": {
      "type": "string",
      "description": "Org this session belongs to, if any"
    },
    "type": {
      "type": "string",
      "enum": ["personal", "meeting"],
      "default": "personal",
      "description": "Personal thinking session or multi-speaker meeting"
    },
    "title": {
      "type": "string",
      "description": "Session title"
    },
    "capture_source": {
      "type": "string",
      "enum": ["mic_live", "bot_live", "import"],
      "default": "import",
      "description": "How utterances arrive: browser mic, Recall meeting bot, or pasted transcript"
    },
    "meeting_url": {
      "type": "string",
      "description": "Meeting link the Recall bot was sent to (bot_live only)"
    },
    "bot_id": {
      "type": "string",
      "description": "Recall bot id (bot_live only)"
    },
    "webhook_token": {
      "type": "string",
      "description": "Per-session random token used to authenticate Recall webhook posts"
    },
    "status": {
      "type": "string",
      "enum": ["active", "processing", "complete"],
      "default": "active",
      "description": "Lifecycle status of the session"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When capture started"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When capture ended"
    },
    "consolidated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Tier-2 consolidation pass last ran"
    },
    "billed_ms": {
      "type": "integer",
      "default": 0,
      "minimum": 0,
      "description": "Transcript minutes (in ms) this session counts against the owner's monthly quota — the span of utterance timestamps, computed once when the session completes. Same metric regardless of capture source (mic, bot, or import)."
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Owner's post-session star rating (1-5), prompted once when a meeting session completes."
    },
    "rating_feedback": {
      "type": "string",
      "description": "Optional free-text feedback given alongside the rating."
    },
    "llm_cost_usd": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "Running estimated Anthropic API cost (USD) for calls made directly against the Anthropic API for this session — Tier-1 and partial-guess calls each add their own call's cost via $inc as they happen (see base44/shared/claude.ts estimateCostUsd). Tier-2 no longer contributes to this field — see gateway_credits_used. Estimated from real per-call token usage x published per-model pricing, not billed truth — good for relative comparisons and admin cost/min, not a guaranteed match to the Anthropic invoice."
    },
    "gateway_credits_used": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "Running Base44 AI Gateway credits consumed by this session's Tier-2 consolidation calls (base44/shared/gateway.ts, consolidate-session), added via $inc from the gateway response's usage.base44_credits as they happen. A different unit than llm_cost_usd (that's a USD estimate for direct Anthropic calls) — convert to USD using your Base44 plan's credit rate."
    }
  },
  "required": ["type", "title"],
  "rls": {
    "create": true,
    "read": { "created_by": "{{user.email}}" },
    "update": { "created_by": "{{user.email}}" },
    "delete": { "created_by": "{{user.email}}" }
  }
}
